{
  "name": "obsidian-ai-accounting",
  "version": "0.7.0",
  "description": "Review AI-extracted expenses and maintain multi-currency Markdown ledgers in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node styles/build.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "styles": "node styles/build.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint --max-warnings 0 . && eslint --max-warnings 0 -c eslint.scorecard.config.mjs . && stylelint --max-warnings 0 \"styles/*.css\" styles.css",
    "test": "node --test tests/*.test.cjs"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^16.11.6",
    "esbuild": "0.25.5",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "stylelint": "17.16.0",
    "tslib": "2.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "obsidian": "^1.14.4"
  },
  "author": "Rexxall"
}
